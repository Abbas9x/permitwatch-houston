# Copy this file to .env and fill it in. NEVER commit .env.
# The server refuses to start if a required variable is missing or malformed.

NODE_ENV=development
PORT=8787

# Comma-separated browser origins allowed to call the API (exact origins, no paths).
# Local dev: the Vite dev server + the API itself. Production: your Render URL.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787

# SQLite file (created automatically).
DATABASE_PATH=./data/permitwatch.db

# Number of reverse proxies in front of the app (Render = 1). Used for rate limiting by real client IP.
TRUST_PROXY=0

LOG_LEVEL=info
