# Copy this file to .env and fill it in. NEVER commit .env.
# The server refuses to start if a required variable is missing or malformed.

NODE_ENV=development
PORT=8787

# Comma-separated browser origins allowed to call the API (exact origins, no paths).
# Local dev: the Vite dev server + the API itself. Production: your Render URL.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787

# SQLite file (created automatically).
DATABASE_PATH=./data/permitwatch.db

# Gemini API key from https://aistudio.google.com/apikey. Server-side only, never sent to the browser.
GEMINI_API_KEY=

# Model IDs were checked against https://ai.google.dev/gemini-api/docs/models and /pricing on 2026-10-10.
# ROUTER must be the cheapest available model (it only answers "simple" or "complex").
GEMINI_MODEL_ROUTER=gemini-3.1-flash-lite
GEMINI_MODEL_SMALL=gemini-3.5-flash-lite
GEMINI_MODEL_LARGE=gemini-3.8-flash

# Thinking levels (Gemini 3.x can't fully disable thinking; "minimal" is the lowest level).
# gemini-3.8-flash supports low|medium|high, and the flash-lite models also support minimal.
GEMINI_THINKING_ROUTER=minimal
GEMINI_THINKING_SMALL=minimal
GEMINI_THINKING_LARGE=low
GEMINI_TIMEOUT_MS=25000

# off  = use the real Gemini API (required when NODE_ENV=production)
# ok   = deterministic offline mock (development/tests, no key needed; clearly labeled in the UI)
# down = mock that always fails (to test graceful degradation)
GEMINI_MOCK=off

# Number of reverse proxies in front of the app (Render = 1). Used for rate limiting by real client IP.
TRUST_PROXY=0

LOG_LEVEL=info
